# Credentials and environment-specific values. Never commit .env - only the
# .env.example template is tracked.
.env
*.env
!.env.example

# Screenshots and run output. Worth keeping out of git on this project in
# particular: the workbench-ui password field exposes its value as plain text
# in the view hierarchy, so hierarchy dumps and debug output can carry the
# password in the clear.
artifacts/
.maestro/
*.mp4
*.png

# OS
.DS_Store
Thumbs.db
